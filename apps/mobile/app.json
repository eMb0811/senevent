{
  "expo": {
    "name": "SenEvent",
    "slug": "senevent",
    "scheme": "senevent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a3a5c"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "sn.ucad.senevent.equipe1",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a3a5c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8f4b2c90-3d1e-4a7b-9e6c-1d2f3a4b5c6d"
      }
    },
    "owner": "mouhamet-barry"
  }
}
